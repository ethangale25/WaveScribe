{
  "name": "wavescribe",
  "version": "1.2.0",
  "description": "A sleek, Apple-inspired voice dictation application with a modern graphical interface.",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "node scripts/copy-ort.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ort.mjs",
    "build": "vite build && electron-builder",
    "eval:build": "esbuild tools/eval/run.ts --bundle --platform=node --format=esm --outfile=tools/eval/run.mjs --external:@huggingface/transformers --external:onnxruntime-node --external:sharp --log-level=warning",
    "icons": "node scripts/make-icons.mjs",
    "eval:commands": "esbuild tools/eval/voice-commands.ts --bundle --platform=node --format=esm --outfile=tools/eval/voice-commands.mjs --external:node-llama-cpp --log-level=warning && node tools/eval/voice-commands.mjs",
    "eval:smart": "esbuild tools/eval/smart-cleanup.ts --bundle --platform=node --format=esm --outfile=tools/eval/smart-cleanup.mjs --external:node-llama-cpp --log-level=warning && node tools/eval/smart-cleanup.mjs",
    "test": "esbuild tests/text-pipeline.test.ts --bundle --platform=node --format=esm --outfile=.test-build/text-pipeline.test.mjs --external:@huggingface/transformers --external:onnxruntime-node --external:sharp --log-level=warning && node --test .test-build/text-pipeline.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@types/node": "^25.3.3",
    "concurrently": "^9.2.1",
    "dompurify": "^3.2.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.8.1",
    "marked": "^15.0.12",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.2",
    "node-llama-cpp": "^3.22.1"
  },
  "build": {
    "appId": "com.wavescribe.app",
    "productName": "WaveScribe",
    "publish": {
      "provider": "github",
      "owner": "ethangale25",
      "repo": "WaveScribe",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/koffi/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "sounds/**/*",
      "package.json",
      "!node_modules/@node-llama-cpp/win-arm64/**",
      "!node_modules/@node-llama-cpp/win-x64-cuda/**",
      "!node_modules/@node-llama-cpp/win-x64-cuda-ext/**"
    ]
  }
}
